# EXAMPLE ONLY: copy to sdkconfig.local, edit locally, never commit credentials.
CONFIG_EDGE_WIFI_SSID="your-2.4GHz-network"
CONFIG_EDGE_WIFI_PASSWORD="replace-with-wifi-password"
CONFIG_EDGE_SERVER_IPV4="192.168.1.100"
CONFIG_EDGE_SERVER_PORT=9000
CONFIG_EDGE_DEVICE_ID="esp32-01"
CONFIG_EDGE_NORMAL_SAMPLES=2048
CONFIG_EDGE_URGENT_SAMPLES=64
CONFIG_EDGE_URGENT_EVERY=5
CONFIG_EDGE_SEND_INTERVAL_MS=250
CONFIG_EDGE_SOCKET_TIMEOUT_MS=10000
CONFIG_EDGE_WIFI_TIMEOUT_MS=15000
